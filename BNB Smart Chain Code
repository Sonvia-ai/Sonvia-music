pragma solidity ^0.8.20; 
 
/** 
 * @title SonviaMusic 
 * @dev Music NFT minting contract with signature verification 
 * Users submit assetId and metadata URI, owner signs the message, user mints on-chain 
 */ 
 
contract SonviaMusic { 
    // Standard ERC721 Events 
    event Transfer(address indexed from, address indexed to, uint256 indexed tokenId); 
    event Approval(address indexed owner, address indexed approved, uint256 indexed tokenId); 
     
    // Custom Events 
    event NFTMinted( 
        uint256 indexed tokenId, 
        address indexed minter, 
        uint256 indexed assetId, 
        string metadataUri 
    ); 
     
    event SignatureVerified( 
        uint256 indexed assetId, 
        address indexed minter, 
        bytes32 messageHash 
    ); 
     
    event OwnerUpdated(address indexed newOwner); 
 
    // State variables 
    string public constant name = "Sonvia Music NFT"; 
    string public constant symbol = "SNFT"; 
     
    address public owner; 
    uint256 private tokenIdCounter; 
     
    // Mapping from assetId to tokenId 
    mapping(uint256 => uint256) public assetIdToTokenId; 
     
    // Mapping from tokenId to assetId 
    mapping(uint256 => uint256) public tokenIdToAssetId; 
     
    // Mapping from tokenId to metadataUri 
    mapping(uint256 => string) public tokenURIs; 
     
    // Mapping from tokenId to owner 
    mapping(uint256 => address) public tokenOwners; 
     
    // Mapping from owner to token count 
    mapping(address => uint256) public balances; 
     
    // Used signatures to prevent replay attacks 
    mapping(bytes32 => bool) public usedSignatures; 
 
    // Custom errors 
    error UnauthorizedOwner(); 
    error InvalidSignature(); 
    error AssetIdAlreadyMinted(); 
    error SignatureAlreadyUsed(); 
    error InvalidMetadataUri(); 
    error TokenNotFound(); 
 
    modifier onlyOwner() { 
        if (msg.sender != owner) { 
            revert UnauthorizedOwner(); 
        } 
        _; 
    } 
 
    constructor() { 
        owner = msg.sender; 
        tokenIdCounter = 1; 
    } 
 
    /** 
     * @dev Updates the contract owner 
     */ 
    function setOwner(address newOwner) external onlyOwner { 
        if (newOwner == address(0)) { 
            revert UnauthorizedOwner(); 
        } 
        owner = newOwner; 
        emit OwnerUpdated(newOwner); 
    } 
 
    /** 
     * @dev Verifies the signature from the contract owner 
     */ 
    function _verifySignature( 
        bytes32 messageHash, 
        bytes memory signature 
    ) internal view returns (bool) { 
        bytes32 ethSignedMessageHash = _getEthSignedMessageHash(messageHash); 
        address signer = _recoverSigner(ethSignedMessageHash, signature); 
        return signer == owner; 
    } 
 
    /** 
     * @dev Creates the message hash for signing 
     */ 
    function getMessageHash( 
        uint256 assetId, 
        string memory metadataUri, 
        address minter 
    ) public pure returns (bytes32) { 
        return keccak256(abi.encodePacked(assetId, metadataUri, minter)); 
    } 
 
    /** 
     * @dev Adds the Ethereum signed message prefix 
     */ 
    function _getEthSignedMessageHash(bytes32 messageHash) 
        internal 
        pure 
        returns (bytes32) 
    { 
        return keccak256( 
            abi.encodePacked( 
                "\x19Ethereum Signed Message:\n32", 
                messageHash 
            ) 
        ); 
    } 
 
    /** 
     * @dev Recovers the signer address from a signature 
     */ 
    function _recoverSigner( 
        bytes32 ethSignedMessageHash, 
        bytes memory signature 
    ) internal pure returns (address) { 
        (bytes32 r, bytes32 s, uint8 v) = _splitSignature(signature); 
        return ecrecover(ethSignedMessageHash, v, r, s); 
    } 
 
    /** 
     * @dev Splits the signature into its components 
     */ 
    function _splitSignature(bytes memory sig) 
        internal 
        pure 
        returns ( 
            bytes32 r, 
            bytes32 s, 
            uint8 v 
        ) 
    { 
        if (sig.length != 65) { 
            revert InvalidSignature(); 
        } 
 
        assembly { 
            r := mload(add(sig, 32)) 
            s := mload(add(sig, 64)) 
            v := byte(0, mload(add(sig, 96))) 
        } 
 
        if (v < 27) { 
            v += 27; 
        } 
 
        if (v != 27 && v != 28) { 
            revert InvalidSignature(); 
        } 
    } 
 
    /** 
     * @dev Mints an NFT with signature verification 
     */ 
    function mintWithSignature( 
        uint256 assetId, 
        string memory metadataUri, 
        bytes memory ownerSignature 
    ) external returns (uint256) { 
        // Validate inputs 
        if (bytes(metadataUri).length == 0) { 
            revert InvalidMetadataUri(); 
        } 
         
        if (assetIdToTokenId[assetId] != 0) { 
            revert AssetIdAlreadyMinted(); 
        } 
 
        // Create and verify signature 
        bytes32 messageHash = getMessageHash(assetId, metadataUri, msg.sender); 
        bytes32 ethSignedMessageHash = _getEthSignedMessageHash(messageHash); 
         
        if (usedSignatures[ethSignedMessageHash]) { 
            revert SignatureAlreadyUsed(); 
        } 
 
        if (!_verifySignature(messageHash, ownerSignature)) { 
            revert InvalidSignature(); 
        } 
 
        // Mark signature as used 
        usedSignatures[ethSignedMessageHash] = true; 
 
        // Mint the NFT 
        uint256 tokenId = tokenIdCounter; 
        tokenIdCounter++; 
 
        tokenOwners[tokenId] = msg.sender; 
        balances[msg.sender]++; 
        tokenURIs[tokenId] = metadataUri; 
        assetIdToTokenId[assetId] = tokenId; 
        tokenIdToAssetId[tokenId] = assetId; 
 
        emit Transfer(address(0), msg.sender, tokenId); 
        emit NFTMinted(tokenId, msg.sender, assetId, metadataUri); 
        emit SignatureVerified(assetId, msg.sender, messageHash); 
 
        return tokenId; 
    } 
 
    /** 
     * @dev Gets the total number of minted NFTs 
     */ 
    function totalSupply() external view returns (uint256) { 
        return tokenIdCounter - 1; 
    } 
 
    /** 
     * @dev Gets the balance of an address 
     */ 
    function balanceOf(address account) external view returns (uint256) { 
        return balances[account]; 
    } 
 
    /** 
     * @dev Gets the owner of a specific token 
     */ 
    function ownerOf(uint256 tokenId) external view returns (address) { 
        address tokenOwner = tokenOwners[tokenId]; 
        if (tokenOwner == address(0)) { 
            revert TokenNotFound(); 
        } 
        return tokenOwner; 
    } 
 
    /** 
     * @dev Gets the metadata URI of a specific token 
     */ 
    function tokenURI(uint256 tokenId) external view returns (string memory) { 
        if (tokenOwners[tokenId] == address(0)) { 
            revert TokenNotFound(); 
        } 
        return tokenURIs[tokenId]; 
    } 
 
    /** 
     * @dev Gets the token ID for a specific asset ID 
     */ 
    function getTokenIdByAssetId(uint256 assetId) external view returns (uint256) { 
        return assetIdToTokenId[assetId]; 
    } 
 
    /** 
     * @dev Gets the asset ID for a specific token ID 
     */ 
    function getAssetIdByTokenId(uint256 tokenId) external view returns (uint256) { 
        return tokenIdToAssetId[tokenId]; 
    } 
}
